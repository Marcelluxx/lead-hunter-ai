# Google Maps Places API Key (Requires Places API V1 enabled)
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key for AI Auditing
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model for Auditing (e.g., meta-llama/llama-3.1-8b-instruct or similar)
LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# Lower-cost model used to clean crawled pages before the final audit.
LLM_MODEL_FREE=google/gemini-2.5-flash:free

# Token optimization mode for website crawling: "high_fidelity" (more context) or "optimized" (fewer tokens)
TOKEN_MODE=high_fidelity

# Optional provider endpoint overrides. Keep HTTPS in production.
GOOGLE_PLACES_V1_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LEADHUNTER_DATABASE_URL=postgresql+psycopg://leadhunter_app:change-me@localhost:5432/leadhunter
LEADHUNTER_REDIS_URL=redis://localhost:6379/0
LEADHUNTER_MASTER_KEY_BASE64=generate-a-32-byte-urlsafe-base64-key
LEADHUNTER_JWT_PRIVATE_KEY_FILE=secrets/jwt_private.pem
LEADHUNTER_JWT_PUBLIC_KEY_FILE=secrets/jwt_public.pem
POSTGRES_ADMIN_PASSWORD=replace-with-random-owner-password
LEADHUNTER_APP_DB_PASSWORD=replace-with-random-app-password
LEADHUNTER_WORKER_DB_PASSWORD=replace-with-random-worker-password

# One-time bootstrap (use an owner URL, then remove these values).
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:change-me@localhost:5432/leadhunter
LEADHUNTER_BOOTSTRAP_EMAIL=admin@example.com
LEADHUNTER_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
LEADHUNTER_BOOTSTRAP_NAME=Platform Administrator
LEADHUNTER_BOOTSTRAP_WORKSPACE_SLUG=first-client
LEADHUNTER_BOOTSTRAP_WORKSPACE_NAME=First Client
LEADHUNTER_BOOTSTRAP_HARD_LIMIT=100.00

# Provider HTTPS chiamato solo dopo consenso esplicito nella GUI.
# In produzione può essere sostituito con un provider contrattualizzato.
IP_GEOLOCATION_URL=https://ipwho.is/
